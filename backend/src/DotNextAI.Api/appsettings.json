{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Llm": {
    "TimeoutSeconds": 120
  },
  "ConnectionStrings": {
    "Chats": "Data Source=App_Data/dotnextai.db"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "RateLimiting": {
    "ChatPermitsPerMinute": 20,
    "ImagePermitsPerMinute": 5
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
