<?xml version="1.0" encoding="utf-8"?>
<!-- The project only needs public packages: ignore machine-level feeds so restore behaves the same everywhere. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
