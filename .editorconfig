root = true

[*]
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_size = 4

[*.{csproj,props,targets,slnx,xml}]
indent_size = 2

[*.{json,yml,yaml,ts,tsx,js,mjs,css}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.sh]
indent_size = 2
end_of_line = lf

# EF Core migrations are generated: analyzers ignore them.
[backend/src/DotNextAI.Persistence/Migrations/**.cs]
generated_code = true
